rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper Functions ──────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isTutor() {
      return isSignedIn() && (request.auth.token.tutor == true || isAdmin());
    }

    // Verified course assignment lookup in Cloud Firestore
    function isAssignedCourseTutor(courseId) {
      return isTutor() && (
        isAdmin() ||
        (
          firestore.exists(/databases/(default)/documents/courses/$(courseId)) &&
          (
            firestore.get(/databases/(default)/documents/courses/$(courseId)).data.tutorId == request.auth.uid ||
            firestore.get(/databases/(default)/documents/courses/$(courseId)).data.tutorUid == request.auth.uid ||
            firestore.get(/databases/(default)/documents/courses/$(courseId)).data.instructorId == request.auth.uid ||
            (('assignedTutors' in firestore.get(/databases/(default)/documents/courses/$(courseId)).data) &&
             request.auth.uid in firestore.get(/databases/(default)/documents/courses/$(courseId)).data.assignedTutors)
          )
        )
      );
    }

    // Verified enrollment lookup in Cloud Firestore
    function isEnrolledStudent(courseId, uid) {
      return firestore.exists(/databases/(default)/documents/enrollments/$(uid + '_' + courseId));
    }

    // Size validation helpers
    function isValidSize(maxMb) {
      return request.resource.size <= maxMb * 1024 * 1024;
    }

    // Allowed image formats (PNG, JPEG, WebP, GIF, SVG)
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Allowed deliverable document formats (PDF, DOC/DOCX, PPT/PPTX, XLS/XLSX, TXT, ZIP, Images)
    function isValidSubmissionType() {
      return isImage() ||
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType == 'text/plain' ||
        request.resource.contentType.matches('application/(zip|x-zip-compressed|x-zip)') ||
        request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*') ||
        request.resource.contentType.matches('application/(msword|vnd\\.ms-excel|vnd\\.ms-powerpoint)');
    }

    // Allowed educational resource file formats
    function isValidResourceType() {
      return isValidSubmissionType() ||
        request.resource.contentType.matches('(video|audio)/.*');
    }

    // ── 1. User Profile Portraits: users/{uid}/portrait/{allPaths=**} ────
    match /users/{uid}/portrait/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidSize(5) && isImage();
    }

    // ── 2. Course Submissions: courses/{courseId}/submissions/{uid}/{allPaths=**} ────
    // Read: Submitting student, verified assigned course tutor, or admin
    // Write: Student owner who is enrolled in this course (max 25MB, validated file types)
    match /courses/{courseId}/submissions/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin() || isAssignedCourseTutor(courseId);
      allow write: if isOwner(uid) && (isEnrolledStudent(courseId, uid) || isAdmin()) && isValidSize(25) && isValidSubmissionType();
    }

    // ── 3. Course Resources: courses/{courseId}/resources/{allPaths=**} ────
    // Read: Enrolled learners, assigned course tutors, or admins
    // Write: Strictly assigned course tutors or admins (max 50MB, validated resource types)
    match /courses/{courseId}/resources/{allPaths=**} {
      allow read: if isSignedIn() && (isEnrolledStudent(courseId, request.auth.uid) || isAssignedCourseTutor(courseId) || isAdmin());
      allow write: if (isAdmin() || isAssignedCourseTutor(courseId)) && isValidSize(50) && isValidResourceType();
    }

    // ── 4. Platform Resources: resources/{allPaths=**} ─────────────
    // Read: All signed-in platform users
    // Write: Strictly verified administrators (max 50MB, validated resource types)
    match /resources/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidSize(50) && isValidResourceType();
    }

    // ── 5. Default Deny ───────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
