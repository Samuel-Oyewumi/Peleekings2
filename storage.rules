rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper Functions ──────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isTutor() {
      return isSignedIn() && (request.auth.token.tutor == true || isAdmin());
    }

    // Verified course assignment lookup in Cloud Firestore
    function isAssignedCourseTutor(courseId) {
      return isTutor() && (
        isAdmin() ||
        (
          firestore.exists(/databases/(default)/documents/courses/$(courseId)) &&
          firestore.get(/databases/(default)/documents/courses/$(courseId)).data.status != 'deleting' &&
          (
            firestore.get(/databases/(default)/documents/courses/$(courseId)).data.tutorId == request.auth.uid ||
            firestore.get(/databases/(default)/documents/courses/$(courseId)).data.tutorUid == request.auth.uid ||
            firestore.get(/databases/(default)/documents/courses/$(courseId)).data.instructorId == request.auth.uid ||
            (('assignedTutors' in firestore.get(/databases/(default)/documents/courses/$(courseId)).data) &&
             request.auth.uid in firestore.get(/databases/(default)/documents/courses/$(courseId)).data.assignedTutors)
          )
        )
      );
    }

    // Verified active enrollment lookup in Cloud Firestore
    function isEnrolledStudent(courseId, uid) {
      return firestore.exists(/databases/(default)/documents/courses/$(courseId)) &&
        firestore.get(/databases/(default)/documents/courses/$(courseId)).data.status == 'published' &&
        firestore.exists(/databases/(default)/documents/enrollments/$(uid + '_' + courseId)) &&
        firestore.get(/databases/(default)/documents/enrollments/$(uid + '_' + courseId)).data.status in ['active', 'approved'];
    }

    // Size validation helpers
    function isValidSize(maxMb) {
      return request.resource != null && request.resource.size <= maxMb * 1024 * 1024;
    }

    // Allowed image formats (PNG, JPEG, WebP, GIF, SVG)
    function isImage() {
      return request.resource != null && request.resource.contentType.matches('image/.*');
    }

    // Allowed deliverable document formats (PDF, DOC/DOCX, PPT/PPTX, XLS/XLSX, TXT, ZIP, Images)
    function isValidSubmissionType() {
      return request.resource != null && (
        isImage() ||
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType == 'text/plain' ||
        request.resource.contentType.matches('application/(zip|x-zip-compressed|x-zip)') ||
        request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*') ||
        request.resource.contentType.matches('application/(msword|vnd\\.ms-excel|vnd\\.ms-powerpoint)')
      );
    }

    // Allowed educational resource file formats
    function isValidResourceType() {
      return request.resource != null && (
        isValidSubmissionType() ||
        request.resource.contentType.matches('(video|audio)/.*')
      );
    }

    // ── 1. User Profile Portraits: users/{uid}/portrait/{allPaths=**} ────
    match /users/{uid}/portrait/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && isValidSize(5) && isImage();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── 2. Course Submissions: courses/{courseId}/submissions/{uid}/{allPaths=**} ────
    // Read: Submitting student, verified assigned course tutor, or admin
    // Write: Student owner who has an active/approved enrollment in this course (max 25MB, validated file types)
    match /courses/{courseId}/submissions/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin() || isAssignedCourseTutor(courseId);
      allow create, update: if isOwner(uid) && (isEnrolledStudent(courseId, uid) || isAdmin()) && isValidSize(25) && isValidSubmissionType();
      allow delete: if isAdmin();
    }

    // ── 3. Course Resources: courses/{courseId}/resources/{allPaths=**} ────
    // Read: Actively enrolled learners, assigned course tutors, or admins
    // Create/Update: Strictly assigned course tutors or admins (max 50MB, validated resource types)
    // Delete: Strictly assigned course tutors or admins
    match /courses/{courseId}/resources/{allPaths=**} {
      allow read: if isSignedIn() && (isEnrolledStudent(courseId, request.auth.uid) || isAssignedCourseTutor(courseId) || isAdmin());
      allow create, update: if (isAdmin() || isAssignedCourseTutor(courseId)) && isValidSize(50) && isValidResourceType();
      allow delete: if isAdmin() || isAssignedCourseTutor(courseId);
    }

    // ── 4. Course Module Materials: courses/{courseId}/{moduleId}/{allPaths=**} ────
    match /courses/{courseId}/{moduleId}/{allPaths=**} {
      allow read: if isSignedIn() &&
        moduleId != 'submissions' &&
        moduleId != 'resources' &&
        (isEnrolledStudent(courseId, request.auth.uid) || isAssignedCourseTutor(courseId) || isAdmin());
      allow create, update: if moduleId != 'submissions' &&
        moduleId != 'resources' &&
        (isAdmin() || isAssignedCourseTutor(courseId)) &&
        isValidSize(50) &&
        isValidResourceType();
      allow delete: if moduleId != 'submissions' &&
        moduleId != 'resources' &&
        (isAdmin() || isAssignedCourseTutor(courseId));
    }

    // ── 5. Platform Resources: resources/{allPaths=**} ─────────────
    // Read: All signed-in platform users
    // Create/Update: Strictly verified administrators (max 50MB, validated resource types)
    // Delete: Strictly verified administrators
    match /resources/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidSize(50) && isValidResourceType();
      allow delete: if isAdmin();
    }

    // ── 6. Default Deny ───────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
