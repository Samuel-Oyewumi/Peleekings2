rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Verified Custom Claims & Assignment Helper Functions ─────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Administrators: Strictly verified via Firebase Authentication Custom Claim
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Tutors: Strictly verified via Custom Claim { tutor: true } or Admin
    function isTutor() {
      return isSignedIn() && (request.auth.token.tutor == true || isAdmin());
    }

    // Verifies whether tutor is assigned to the course
    function isAssignedTutor(courseData) {
      return isTutor() && (
        isAdmin() ||
        courseData.tutorId == request.auth.uid ||
        courseData.tutorUid == request.auth.uid ||
        courseData.instructorId == request.auth.uid ||
        (('assignedTutors' in courseData) && request.auth.uid in courseData.assignedTutors)
      );
    }

    function isAssignedCourseTutor(courseId) {
      return isTutor() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/courses/$(courseId)) &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.status != 'deleting' &&
          isAssignedTutor(get(/databases/$(database)/documents/courses/$(courseId)).data)
        )
      );
    }

    // Unpublished course protection: course must exist; only admin or assigned tutor can access unpublished course content
    function canReadCourse(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/courses/$(courseId)) && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published' ||
          isAdmin() ||
          isAssignedCourseTutor(courseId)
        );
    }

    function canManageCourse(courseId) {
      return isAdmin() || isAssignedCourseTutor(courseId);
    }

    function isEnrolled(courseId, uid) {
      return exists(/databases/$(database)/documents/courses/$(courseId)) &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published' &&
        exists(/databases/$(database)/documents/enrollments/$(uid + '_' + courseId)) &&
        get(/databases/$(database)/documents/enrollments/$(uid + '_' + courseId)).data.status in ['active', 'approved'];
    }

    function canAccessCourseMaterials(courseId) {
      return isSignedIn() && (
        isAdmin() ||
        isAssignedCourseTutor(courseId) ||
        (canReadCourse(courseId) && isEnrolled(courseId, request.auth.uid))
      );
    }

    // ── 1. Users Collection ──────────────────────────────────────────
    // Server-managed fields (role, submittedRole, regNumber, status, admin, tutor) cannot be set by clients.
    // Explicit allowlists govern creation and modification.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Explicit allowlist of registration fields; client cannot set role or server fields
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'fullName', 'surname', 'firstName',
          'studentType', 'nyscStateCode', 'phoneNumber',
          'status', 'createdAt', 'photoURL', 'avatarUrl', 'bio', 'interests'
        ]) &&
        !request.resource.data.keys().hasAny([
          'role', 'submittedRole', 'regNumber', 'admin', 'tutor'
        ]) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active');

      // Update: strictly allowlisted non-privileged fields; server-managed fields blocked
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'fullName', 'surname', 'firstName', 'phoneNumber',
          'studentType', 'nyscStateCode', 'photoURL',
          'avatarUrl', 'bio', 'interests', 'updatedAt'
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'submittedRole', 'regNumber', 'status',
          'admin', 'tutor', 'uid', 'email'
        ])
      );

      allow delete: if isAdmin();
    }

    // ── 2. Courses Collection & Subcollections ───────────────────────
    // Tutors can only manage courses assigned to them; unpublished content is protected.
    // Classroom subcollections require an active/approved enrollment, assigned tutor, or admin.
    match /courses/{courseId} {
      allow read: if resource.data.status == 'published' || isAdmin() || (resource.data.status != 'deleting' && isAssignedTutor(resource.data));
      allow create: if isAdmin() || (isTutor() && (request.resource.data.tutorId == request.auth.uid || request.resource.data.tutorUid == request.auth.uid));
      allow update: if isAdmin() || (isTutor() && resource.data.status != 'deleting' && isAssignedTutor(resource.data));
      allow delete: if isAdmin();

      match /modules/{moduleId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /lessons/{lessonId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /announcements/{announcementId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /comments/{commentId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create: if canAccessCourseMaterials(courseId) && request.resource.data.uid == request.auth.uid;
        allow update: if isOwner(resource.data.uid) && canAccessCourseMaterials(courseId);
        allow delete: if isAdmin() || isOwner(resource.data.uid) || canManageCourse(courseId);
      }

      match /notes/{noteId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /assignments/{assignmentId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /tests/{testId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /resources/{resourceId} {
        allow read: if canAccessCourseMaterials(courseId);
        allow create, update, delete: if canManageCourse(courseId);
      }

      match /analytics/{docId} {
        allow read: if isAdmin() || isAssignedCourseTutor(courseId);
        allow write: if false;
      }
    }

    // ── 3. Enrollments Collection ────────────────────────────────────
    // Authoritative enrollment creation and status transitions are handled server-side via Cloud Functions
    // (requestCourseEnrollment, manageEnrollmentStatus, adminManageEnrollment).
    // Client cannot grant active/approved status, modify enrollment status, or set privileged fields.
    match /enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin() || isAssignedCourseTutor(resource.data.courseId);

      // Direct client creation is restricted to pending requests on existing published courses with no privileged fields
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.courseId is string &&
        enrollmentId == request.auth.uid + '_' + request.resource.data.courseId &&
        exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId)) &&
        get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'published' &&
        request.resource.data.status == 'pending' &&
        (!('progressPercent' in request.resource.data) || request.resource.data.progressPercent == 0) &&
        (!('completedItemIds' in request.resource.data) || request.resource.data.completedItemIds.size() == 0) &&
        !request.resource.data.keys().hasAny([
          'role', 'userRole', 'admin', 'tutor',
          'isPaid', 'paymentStatus', 'paymentId', 'amountPaid',
          'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy',
          'accessGrantedBy', 'accessLevel',
          'revokedBy', 'revokedAt', 'grade', 'certificateIssued'
        ]);

      // Student enrollment progress updates: learning-progress fields ONLY when enrollment is already active/approved.
      // Tutors and students cannot directly mutate enrollment status from the client; status transitions go through Cloud Functions.
      allow update: if isAdmin() || (
        isOwner(resource.data.uid) &&
        resource.data.status in ['active', 'approved'] &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedItemIds', 'completedLessonIds', 'lastAccessedLesson',
          'currentModule', 'progressPercent', 'notes', 'updatedAt'
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'role', 'userRole', 'admin', 'tutor',
          'isPaid', 'paymentStatus', 'paymentId', 'amountPaid',
          'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy',
          'accessGrantedBy', 'accessLevel',
          'revokedBy', 'revokedAt', 'grade', 'certificateIssued',
          'uid', 'courseId', 'experienceType'
        ])
      );

      allow delete: if isAdmin();
    }

    // ── 4. Submissions (Assignments & Tests) ─────────────────────────
    // Students submit deliverables only for courses in which they have an active/approved enrollment.
    // Tutors can only read and grade submissions for courses assigned to them.
    match /assignmentSubmissions/{submissionId} {
      allow read: if isOwner(resource.data.uid) || isAdmin() || isAssignedCourseTutor(resource.data.courseId);

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.courseId is string &&
        isEnrolled(request.resource.data.courseId, request.auth.uid) &&
        !request.resource.data.keys().hasAny(['grade', 'feedback', 'gradedAt', 'gradedBy']);

      // Grading restricted exclusively to Admins and assigned course Tutors
      allow update: if isAdmin() || (
        isAssignedCourseTutor(resource.data.courseId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'grade', 'feedback', 'status', 'gradedAt', 'gradedBy'
        ])
      );

      allow delete: if isAdmin();
    }

    match /testSubmissions/{submissionId} {
      allow read: if isOwner(resource.data.uid) || isAdmin() || isAssignedCourseTutor(resource.data.courseId);

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.courseId is string &&
        isEnrolled(request.resource.data.courseId, request.auth.uid) &&
        !request.resource.data.keys().hasAny(['grade', 'feedback', 'gradedAt', 'gradedBy']);

      // Grading restricted exclusively to Admins and assigned course Tutors
      allow update: if isAdmin() || (
        isAssignedCourseTutor(resource.data.courseId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'grade', 'feedback', 'status', 'gradedAt', 'gradedBy'
        ])
      );

      allow delete: if isAdmin();
    }

    // ── 5. Tutor Applications Collection ─────────────────────────────
    match /tutorApplications/{applicationId} {
      allow create: if isSignedIn() &&
        request.resource.data.applicantUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow read: if isSignedIn() && (resource.data.applicantUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── 6. Milestones & Celebrations Collection ───────────────────────
    match /milestones/{milestoneId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isTutor());
      allow update, delete: if isAdmin();
    }

    // ── 7. Audit Logs Collection (Server-Controlled Only) ────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── 8. User Notifications Subcollection ──────────────────────────
    // Creation is server-controlled via Cloud Functions; owners may only update read/readAt.
    match /users/{uid}/notifications/{notifId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if false;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        request.resource.data.read is bool &&
        (!('readAt' in request.resource.data) || request.resource.data.readAt == null || request.resource.data.readAt is timestamp || request.resource.data.readAt is string);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── 9. User Daily Activity Subcollection ─────────────────────────
    match /users/{uid}/dailyActivity/{dayId} {
      allow read, write: if isOwner(uid);
      allow read: if isAdmin() || isTutor();
    }

    // ── 10. Platform & Course Resources Collection ───────────────────
    match /resources/{resourceId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        !('courseId' in resource.data) ||
        resource.data.courseId == 'platform' ||
        isEnrolled(resource.data.courseId, request.auth.uid) ||
        isAssignedCourseTutor(resource.data.courseId)
      );
      allow create, update: if isAdmin() || (
        isTutor() &&
        'courseId' in request.resource.data &&
        request.resource.data.courseId != 'platform' &&
        isAssignedCourseTutor(request.resource.data.courseId)
      );
      allow delete: if isAdmin() || (
        isTutor() &&
        'courseId' in resource.data &&
        resource.data.courseId != 'platform' &&
        isAssignedCourseTutor(resource.data.courseId)
      );
    }

    // ── 11. Platform Announcements Collection ────────────────────────
    match /announcements/{announcementId} {
      // Admins can read all announcements (drafts, scheduled, expired).
      // Regular users can only read published, non-expired announcements matching their audience.
      allow read: if isAdmin() || (
        isSignedIn() &&
        resource.data.status == 'published' &&
        (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time) &&
        (
          resource.data.audience == 'all' ||
          (resource.data.audience == 'learners' && !isTutor()) ||
          (resource.data.audience == 'tutors' && isTutor()) ||
          (resource.data.courseId != null && isEnrolled(resource.data.courseId, request.auth.uid))
        )
      );

      allow create, update, delete: if isAdmin();
    }

    // ── 12. Platform Settings Collection ─────────────────────────────
    match /platformSettings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── 13. Registration Numbers (Server Only) ──────────────────────
    match /regNumbers/{code} {
      allow read, write: if false;
    }

    // ── 14. Default Deny ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
